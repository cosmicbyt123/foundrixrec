# ==============================================================================
# FOUNDRIX 2026 — Production .gitignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Production Build Outputs
dist/
dist-ssr/
build/
out/
.next/
*.local

# Environment Variables & Secrets (CRITICAL for production security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Large Media & Video Screen Recordings (never commit heavy binaries to git)
*.mp4
*.webm
*.mov
*.avi
*.mkv
*preview.jpg
*preview.png
public/assets/*preview.jpg
public/assets/*preview.png

# Reference Templates & Raw Screen Captures
template/
assests/

# Temporary / Scratch & Test Scripts
scratch/
test_system.py
manage_teams.py
scanner.html
*.tmp
*.bak
*.swp
*.swo

# Python Cache & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs & Debug Reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cloudflare / Serverless Artifacts
.wrangler/
.mf/